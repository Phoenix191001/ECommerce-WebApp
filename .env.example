# MongoDB Atlas connection string (Cluster0 in the "Saad" project).
# Each store gets its own database named inst_<instanceId>; the platform data lives in PLATFORM_DB_NAME.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.rjy0oy7.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
PLATFORM_DB_NAME=platform

# Signs the Super Admin session cookie. Generate with: openssl rand -base64 48
AUTH_SECRET=

# Domain that stores live under as subdomains (e.g. yourplatform.com).
# Use localhost:3000 for local development (stores at http://<sub>.localhost:3000).
# On a *.vercel.app domain, stores are served at /s/<subdomain> instead.
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
